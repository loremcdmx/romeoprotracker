{
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    { "source": "/((?!assets/|data/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
