{
  "name": "romeoprotracker",
  "private": true,
  "version": "1.13.5",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "sync:data": "node scripts/sync-static-data.mjs",
    "predev": "npm run sync:data",
    "prebuild": "npm run sync:data",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run test && node scripts/data-integrity-smoke.mjs && node scripts/vercel-ignore-build-smoke.mjs",
    "favicon": "node scripts/generate-favicon.mjs",
    "scrape": "node scripts/scrape.mjs",
    "scrape:dry-run": "node scripts/scrape.mjs --dry-run",
    "scrape:no-push": "node scripts/scrape.mjs --no-push",
    "scrape:full": "node scripts/scrape.mjs --mode=full",
    "scrape:reextract": "node scripts/scrape.mjs --mode=reextract",
    "scrape:translate": "node scripts/scrape.mjs --mode=translate"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.4"
  }
}
